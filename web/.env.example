# Upstash Redis - ücretsiz tier yeterli. https://console.upstash.com adresinden oluştur,
# "REST API" sekmesindeki URL ve TOKEN değerlerini buraya yapıştır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Günlük ücretsiz hak
DAILY_FREE_SEARCHES=3

# Cloudflare Turnstile (opsiyonel, ücretsiz bot koruması)
# https://dash.cloudflare.com adresinden "Turnstile" > site ekle, secret key'i buraya yapıştır.
# Tanımlamazsan doğrulama otomatik atlanır.
TURNSTILE_SECRET_KEY=
