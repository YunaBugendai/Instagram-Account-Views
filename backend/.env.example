# Sunucu
PORT=3000
NODE_ENV=development

# Redis - günlük arama hakkı sayaçları için
REDIS_URL=redis://localhost:6379

# Postgres - ödül/abuse kayıtları için
DATABASE_URL=postgres://iav:iav@localhost:5432/iav

# Günlük ücretsiz hak
DAILY_FREE_SEARCHES=3

# CORS - mobil uygulamanın hangi origin'lerden istek atabileceği (Expo dev sunucusu için * bırakılabilir, production'da daraltın)
CORS_ORIGIN=*

# --- AdMob Server-Side Verification ---
# Bu değerler senin AdMob hesabından: AdMob konsolu > Uygulamalar > İlgili uygulama > Reklam birimleri > Ödüllü > SSV ayarları
# https://apps.admob.com adresinden alınır, bu repo bunları içermez
ADMOB_SSV_PUBLIC_KEYS_URL=https://gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_ALLOWED_AD_UNIT_IDS=

# --- Play Integrity API (Android cihaz doğrulama) ---
# Google Cloud Console > API ve Servisler > Play Integrity API üzerinden alınır
GOOGLE_CLOUD_PROJECT_NUMBER=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_PATH=

# --- Apple App Attest (iOS cihaz doğrulama) ---
# Apple Developer hesabından Team ID ve App Attest ortam ayarı
APPLE_TEAM_ID=
APPLE_APP_ATTEST_ENV=production

# Android paket adı - Play Integrity doğrulaması bu paket için yapılır
ANDROID_PACKAGE_NAME=com.enes.instagramaccountviews
